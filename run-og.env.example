# Settings for run-og.sh. Copy to run-og.env (gitignored); loaded on every run, one KEY=VALUE per line.
# Comment a line out (#) to turn it off. Values from the real environment win.

# --- Vulkan validation layer (tools/vvl), log written to games/overgeared/vvl.txt ---
#VK_ADD_LAYER_PATH='C:\path	o\wwd\tools\vvl'
#VK_LOADER_LAYERS_ENABLE='*validation'
#VK_KHRONOS_VALIDATION_DEBUG_ACTION=VK_DBG_LAYER_ACTION_LOG_MSG
#VK_KHRONOS_VALIDATION_LOG_FILENAME='C:\path	o\wwd\games\overgeared\vvl.txt'
#VK_KHRONOS_VALIDATION_REPORT_FLAGS=error,warn
#VK_KHRONOS_VALIDATION_DUPLICATE_MESSAGE_LIMIT=3

# --- wwd diagnostics ---
#WWD_FPS=1                    # print frame rate every 2 s
#WWD_TRACE_OPEN=1             # log every file open (and failures)
#WWD_TRACE_IMAGES=1           # log render-target creations
#WWD_CAPTURE=1500,2200        # dump these presented frames to capture_N.bmp
#WWD_VK_TRACE=1               # trace Vulkan calls (2 = before each call)
#WWD_TRACE_NET=1
#WWD_TRACE_DNS=1
